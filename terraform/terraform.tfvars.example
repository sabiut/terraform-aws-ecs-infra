# AWS Configuration
aws_region = "ap-southeast-2"

# Project Configuration
project_name = "ecs-three-tier"
environment  = "dev"

# Network Configuration
# The ALB needs public subnets, and RDS needs database subnets, in at least
# two availability zones. Both lists are matched to availability_zones by index.
vpc_cidr              = "10.0.0.0/16"
availability_zones    = ["ap-southeast-2a", "ap-southeast-2b"]
public_subnet_cidrs   = ["10.0.1.0/24", "10.0.11.0/24"]
private_subnet_cidr   = "10.0.2.0/24"
database_subnet_cidrs = ["10.0.3.0/24", "10.0.4.0/24"]

# Database Configuration
# The master password is generated by RDS and stored in Secrets Manager;
# there is no password variable.
db_instance_class = "db.t3.micro"
db_name           = "appdb"
db_username       = "admin"

# Optional: ACM certificate ARN to enable the HTTPS listener on the ALB.
# certificate_arn = "arn:aws:acm:ap-southeast-2:123456789012:certificate/..."

# Note: Copy this file to terraform.tfvars and update the values as needed
# Remember to keep terraform.tfvars out of version control for security
